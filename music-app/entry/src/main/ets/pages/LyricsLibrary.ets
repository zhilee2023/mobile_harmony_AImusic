export interface LyricSample { title: string; lyrics: string; }

function song(title: string, verse: string[], chorus: string[]): LyricSample {
  return { title: title, lyrics: '[intro-short]\n[verse]\n' + verse.join('\n') + '\n[chorus]\n' + chorus.join('\n') + '\n[outro-short]' };
}

